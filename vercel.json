{
  "version": 2,
  "name": "vignaharta-online-services",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/pan-services-expiry",
      "schedule": "0 0 * * *"
    }
  ],
  "regions": ["bom1"],
  "framework": "nextjs"
}
